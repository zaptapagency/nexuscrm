{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm install && npm run build",
    "startCommand": "npm run start"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "always",
    "sleepApplication": false,
    "preDeployCommand": "npm run db:push && npm run db:seed"
  },
  "env": {
    "NEXTAUTH_URL": "${{ public.RAILWAY_PUBLIC_DOMAIN }}",
    "NEXTAUTH_SECRET": { "description": "Generate with: openssl rand -base64 32" },
    "DATABASE_URL": "${{ Postgres.DATABASE_URL }}",
    "NODE_ENV": "production"
  },
  "plugins": [
    {
      "source": "github.com/railwayapp/plugins",
      "ref": "v1",
      "config": {
        "id": "postgresql"
      }
    }
  ]
}
